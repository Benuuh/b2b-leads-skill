# New installs: an isolated PostgreSQL database for the local Skill core.
SCA_DATABASE_URL=postgresql+psycopg://acq:replace-with-local-password@127.0.0.1:55432/sca_skill_v2
# SCA_ARTIFACT_ROOT=./data/skill-v2
SCA_FIXTURE_MODE=false
# 部署环境：未设置视为 development。production 下缺少信封密钥将拒绝启动。
# SCA_ENV=development

# --- Secrets（spec b2b-leads-2.6 §3.5：宁可起不来，不要跑一半崩）---
# 原始记录信封加密密钥（独立密钥，不与其他密钥混用）。
# 生产必填；开发缺省时降级明文存信封并打 dev-insecure 标记。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
# PROSPECT_SOURCE_RAW_ENVELOPE_SECRET=

# 游标签名密钥（S13 预埋：分页未实现，生成不用）。配置后必须 ≥32 字节。
# PROSPECT_CURSOR_SECRET=

# 付费数据源凭据密钥：当前 paid_sources=0，不需要；接入付费源后必填。
# PROVIDER_CREDENTIAL_KEY=
# Existing .env DATABASE_URL may supply connection details; the default database
# is rewritten to sca_skill_v2. Legacy secrets and login files are not used.
